// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id            String      @id
  name          String
  category      String
  description   String
  photo         String?
  link          String?
  createdAt     DateTime    @default(now())
  members       User[]      @relation("Membership")
  announcements Announcement[]
  eventsRelated Event[]
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  name      String
  role      String
  createdAt DateTime       @default(now())
  organizations Organization[] @relation("Membership")
  announcements Announcement[]
  eventsCreated Event[]
}

model OrganizationRequest {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String
  submittedBy String?
  createdAt   DateTime @default(now())
}


model Announcement {
  id             String       @id @default(uuid())
  title          String
  content        String
  organizationId String?
  authorId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([authorId])
}


model Category {
    id              String      @id @default(uuid())
    text            String
    eventsRelated   Event[]
}


model Event {
    id              String          @id
    name            String
    description     String
    status          EventStatus     @default(Upcoming)
    startDate       DateTime
    endDate         DateTime
    eventPhotoUrl   String?
    location        String

    categories      Category[]
    schedules       EventSchedule[]
    orgsRelated     Organization[]
    galleryPhotos   EventPhoto[]
    
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @default(now())
    createdById String?
    createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
}


enum EventStatus {
    Ongoing
    Upcoming
    Finished
}


model EventSchedule {
    id              String          @id @default(uuid())
    eventId         String
    event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
    title           String
    date            DateTime
    startTime       DateTime
    endTime         DateTime
    location        String
    description     String

    @@index([eventId])
}


model EventPhoto {
    id          String      @id @default(uuid())
    eventId     String
    event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
    photoUrl    String
    caption     String

    @@index([eventId])
}


